# SERVER PORTS & URLS
BACKEND_PORT=2500
BACKEND_HOST_PORT=2500
WEB_HOST_PORT=2000
POSTGRES_HOST_PORT=2555
REDIS_HOST_PORT=2525
NODE_ENV=development
FRONTEND_URL=http://localhost:2000
BACKEND_URL=http://localhost:2500
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_PING_PATH=/health/live
MIGRATIONS_RUN=false
SWAGGER_ENABLED=false
REDIS_URL=redis://localhost:2525

# Docker database credentials
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# SUPERADMIN DETAILS
SUPERADMIN_FULLNAME=Portfolio Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# DATABASE
DATABASE_URL=postgresql://portfolio:change-me@localhost:2555/portfolio

# JWT AUTHENTICATION
JWT_SECRET=change-me-to-a-long-random-secret

# Chatbot API
OPENAI_API_KEY=
GROQ_API_KEYS=
GROQ_MODELS=

# SELENIUM AUTOMATION
SEEDTRACKER_USERNAME=
SEEDTRACKER_PASSWORD=

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:2500/auth/google/callback

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GOOGLE SERVICE ACCOUNT
GOOGLE_SERVICE_ACCOUNT_JSON=

# RECAPTCHA (secret key from Google)
RECAPTCHA_SECRET_KEY=

# BREVO EMAIL SERVICE
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ONA API
ONA_API_KEY=
ONA_BASE_URL=

# Web client
VITE_API_URL=http://localhost:2500
VITE_RECAPTCHA_SITE_KEY=
